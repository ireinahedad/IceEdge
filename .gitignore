# Root
node_modules/
.DS_Store
*.log

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Python caches
__pycache__/
*.pyc

# SEO generator sample output (offline --sample runs)
client/scripts/_sample_out/

# ── Sorties de compilation ────────────────────────────────────────────────────
# Produites par `npm run build`. Elles existent déjà sur le disque sans avoir
# jamais été suivies : sans ces règles, un `git add -A` les embarquerait, et
# chaque build ferait ensuite un diff de plusieurs milliers de lignes générées.
server/dist/
client/dist/

# Rapports de couverture (vitest)
coverage/

# ── Content engine : sorties régénérables ────────────────────────────────────
# Regénérés tous les 3 jours par `npm run content:insights` (server/) : les
# versionner ne produirait qu'un diff de plusieurs milliers de lignes par run,
# sans rien apporter — la source de vérité est l'API NHL, pas le dépôt.
content/output/
content/data/content_insight_*.csv
content/data/content_insight_meta.json

# ── ML : données lourdes & régénérables (on garde le code + les modèles) ───────
# Régénérables via ml/python/fetch_data_v4.py puis build_dataset.py.
# NB : ml/models/*.json (petits, embarqués dans l'image Docker) et les petits
# ml/data/*.json (arenas, scratches…) restent suivis — ne pas les ignorer.
ml/data/*.csv
ml/data/*.parquet
ml/data/raw/**/*.csv
ml/data/raw/**/*.zip
ml/data/raw/**/*.zip.zip
ml/data/raw/**/*.xlsx
ml/data/raw/**/*.parquet
.claude-tmp/

# Ensemble bootstrap du modèle de score (S1) : 20 membres, 8.9 Mo, régénérables
# par `python train_score.py --ensemble 20`. σ n'est consommée par aucun code de
# mise — c'est un diagnostic hors ligne. Déjà exclu de l'image Docker
# (ml/.dockerignore) ; sorti du dépôt le 2026-08-10.
ml/models/score_ensemble/

# Fichiers retirés du produit, gardés hors dépôt en attendant une suppression
# manuelle (le bridge ne peut pas supprimer). Sortis de l'index le 2026-08-25.

# Écrit par l'application de bureau Claude, jamais par le produit. Suivi par
# git jusqu'au 2026-09-08 (3 fichiers, ~735 Ko : un témoin SEO en double et deux
# captures), embarqué par un `git add -A` comme `.claude-tmp/` avant lui. Le
# dossier peut être recréé à tout moment : c'est pour ça qu'il est ignoré et pas
# seulement effacé.
Claude outputs/

# Sauvegardes de purge:stale (données joueurs)
server/.purge-backups/

# Snapshots The Odds API (backfill payant, 2026-09-27) : ~40 Mo par saison,
# PAYÉS et irremplaçables sans repayer — à sauvegarder hors Git, pas à supprimer.
ml/data/raw/odds/oddsapi/

# Sauvegardes automatiques (ex. odds.csv.bak posé par fetch_data_v4.py,
# odds.csv.backup-2026-08-23). Pas BACKUP_DR.md : le motif exige le point.
*.bak
*.backup-*
