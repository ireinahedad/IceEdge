# ml/data/*.json (arenas, scratches…) restent suivis — ne pas les ignorer.
ml/data/*.csv
ml/data/*.parquet
ml/data/raw/**/*.csv
ml/data/raw/**/*.zip
ml/data/raw/**/*.zip.zip
ml/data/raw/**/*.xlsx
ml/data/raw/**/*.parquet
