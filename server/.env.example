# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://iceedge.vercel.app   # URL Vercel en prod

# ── Base de données ───────────────────────────────────────────────────────────
# Option A : Neon — dashboard → Connection Details → cocher « Connection pooling ».
# L'hôte DOIT contenir "-pooler" : l'endpoint direct plafonne à quelques dizaines
# de connexions et sature dès qu'on scale (voir DEPLOYMENT.md §1). Le serveur
# émet un avertissement au démarrage si ce n'est pas le cas.
DATABASE_URL=postgresql://[USER]:[PASSWORD]@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/iceedge?sslmode=require

# Option B : variables séparées (Railway les injecte automatiquement)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=IceedgeDB
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Chiffrement au repos (secrets utilisateurs) ───────────────────────────────
# Clé 32 octets (64 caractères hex) pour chiffrer les secrets stockés en base
# (ex. la clé OpenAI personnelle des utilisateurs FREE). AES-256-GCM.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBLIGATOIRE en production. Après l'avoir définie : npm run db:encrypt-keys
ENCRYPTION_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ton-backend.railway.app/api/auth/google/callback
CLIENT_URL=https://iceedge.vercel.app

# ── GitHub Models (Ask LLM pour les utilisateurs PRO) ─────────────────────────
# Fine-grained PAT avec la permission "Models: read".
# https://github.com/settings/personal-access-tokens  → commence par github_pat_...
# Les utilisateurs FREE utilisent leur propre clé OpenAI (Settings → AI Settings).
GITHUB_MODELS_TOKEN=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Clé API depuis https://resend.com/api-keys. Laisser vide en dev → les codes
# sont affichés dans la console au lieu d'être envoyés.
RESEND_API_KEY=
# Expéditeur vérifié. En test, utiliser onboarding@resend.dev.
RESEND_FROM=ArakIce <onboarding@resend.dev>

# ── Web Push (notifications value bets) ───────────────────────────────────────
# Générer une fois : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@iceedge.app
PUSH_SCAN_ENABLED=false
PUSH_SCAN_INTERVAL_MIN=30

# ── Règlement automatique des paris (settlement) ──────────────────────────────
# Le job de règlement est événementiel : il dort jusqu'à l'approche de l'heure
# de début du prochain match référencé par un slip en attente, poll vite pendant
# le match, puis se rendort. Quand rien n'est en attente, il dort longtemps pour
# laisser la base Neon se mettre en veille (scale-to-zero) et réduire le compute.
# Un nouveau pari réveille le job immédiatement (kick in-process).
#   SETTLEMENT_POLL_MIN     : intervalle rapide pendant qu'un match est en cours (défaut 2)
#   SETTLEMENT_IDLE_POLL_MIN: intervalle quand rien n'est en attente (défaut 15 en prod)
#   SETTLEMENT_PREROLL_MIN  : combien de minutes avant le coup d'envoi commencer à poller (défaut 2)
#   SETTLEMENT_FALLBACK_MIN : passe de sécurité complète, filet de secours (défaut 60)
# Pour revenir à un poll fixe toutes les 5 min : SETTLEMENT_POLL_MIN=5 et SETTLEMENT_IDLE_POLL_MIN=5.
SETTLEMENT_POLL_MIN=2
SETTLEMENT_IDLE_POLL_MIN=15
SETTLEMENT_PREROLL_MIN=2
SETTLEMENT_FALLBACK_MIN=60

# ── Mode veille hors-saison ───────────────────────────────────────────────────
# true = l'API démarre normalement mais AUCUN job de fond ne tourne (règlement,
# value bets, nettoyage, log des cotes). Sert à laisser le compute Neon dormir
# hors saison NHL. Conséquence : les paris placés pendant cette période restent
# en attente jusqu'au retour à false (le job rattrape tout au redémarrage).
# Attention : ce n'est pas zéro compute — une visite du site réveille la base.
DORMANT=false

# ── Sonde de readiness (/health/ready) ────────────────────────────────────────
# Durée de mise en cache d'un SELECT 1 réussi. Neon suspend son compute après
# 5 min d'inactivité : une sonde de monitoring toutes les 1-5 min qui interroge
# la base à chaque appel maintient le compute allumé 24/7 et annule le travail
# événementiel du job de règlement ci-dessus. Le TTL doit donc rester supérieur
# à la fenêtre de suspension. Les échecs ne sont jamais mis en cache : panne et
# rétablissement sont vus à la cadence réelle des sondes.
READINESS_DB_TTL_MS=600000

# DEV UNIQUEMENT : true = désactive la confirmation par courriel (inscription
# connecte directement, login jamais bloqué). Remettre à false une fois Resend prêt.
EMAIL_VERIFICATION_DISABLED=false

# ── Abonnements (Stripe) ──────────────────────────────────────────────────────
# Laisser STRIPE_SECRET_KEY vide → /subscription/checkout active Pro en mode démo
# (sans paiement) pour tester le gating. Une fois branché, remplir ces valeurs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# ── Service ML Python ─────────────────────────────────────────────────────────
# EN PROD : pas de domaine public sur le service ML. Utiliser le réseau privé
# Railway → http://<nom-du-service>.railway.internal:<port> (gratuit, pas d'egress,
# surface d'attaque nulle). Le port est celui qu'uvicorn annonce au démarrage
# ("Uvicorn running on http://[::]:8080") — Railway injecte $PORT, souvent 8080,
# et non le 8000 par défaut du Dockerfile. Cf. DEPLOYMENT.md §3.
ML_SERVICE_URL=http://iceedge-ml.railway.internal:8080
# Mettre à true pour lancer SANS le service ML (l'app retombe sur les règles).
# Évite les appels inutiles au service Python quand il n'est pas déployé.
ML_DISABLED=false
# Secret partagé envoyé dans l'en-tête X-ML-Token à chaque appel d'inférence.
# DOIT être identique à ML_API_TOKEN côté service Python, qui refuse de démarrer
# sans lui en prod. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ML_API_TOKEN=

# ── The Odds API (cotes Bet365, proxifié par /api/odds) ───────────────────────
# Clé gratuite sur https://the-odds-api.com. Vit UNIQUEMENT côté serveur —
# le client passe par le proxy /api/odds/*, la clé n'est jamais envoyée au navigateur.
ODDS_API_KEY=

# ── Stockage des avatars (Cloudflare R2) ──────────────────────────────────────
# Sans ces variables, les avatars restent stockés en data-URI base64 dans
# Postgres (comportement historique) — l'app fonctionne, mais chaque avatar pèse
# ~27 ko dans la base ET dans chaque payload de chat/leaderboard.
#
# Mise en place, une fois, dans le dashboard Cloudflare :
#   1. R2 → Create bucket (« arakice-avatars »).
#   2. Onglet Settings du bucket → Public access : activer le sous-domaine r2.dev
#      OU brancher un domaine perso (ex. cdn.arakice.com). Copier l'URL obtenue
#      dans R2_PUBLIC_URL — c'est elle que les navigateurs appelleront.
#   3. R2 → Manage API tokens → Create token, permission « Object Read & Write »,
#      limité à ce seul bucket. Copier Access Key ID et Secret Access Key.
#   4. R2_ACCOUNT_ID = l'Account ID visible en haut à droite du dashboard.
#
# Le bucket doit être public en LECTURE seule (les écritures passent par le
# serveur, avec le token ci-dessous). Ne jamais exposer ces clés au client.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# DOIT correspondre exactement au nom du bucket dans le dashboard R2.
R2_BUCKET=arakice-avatars
# Sans slash final. Ex. https://pub-xxxxxxxx.r2.dev ou https://cdn.arakice.com
R2_PUBLIC_URL=

# Optionnel. À renseigner UNIQUEMENT si le bucket a été créé avec une
# « jurisdiction » (EU / FedRAMP) : il n'est alors pas joignable sur l'endpoint
# standard et R2 répond « Access Denied ».
#   Jurisdiction EU → https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Données Tennis (RapidAPI) ─────────────────────────────────────────────────
# Clé RapidAPI pour le flux de données tennis. Vide → données mock.
RAPIDAPI_KEY=

# ── Données NHL ───────────────────────────────────────────────────────────────
# Mettre à true pour peupler artificiellement matchs/équipes/joueurs avec des
# données mock (utile hors-saison ou en démo). false = API NHL live.
NHL_USE_MOCK=false

# ── Monitoring d'erreurs (Sentry) ─────────────────────────────────────────────
# DSN du projet Sentry backend. Vide → monitoring désactivé (no-op).
SENTRY_DSN=
# Fraction des requêtes tracées pour la performance (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Arrêt gracieux ────────────────────────────────────────────────────────────
# Délai (ms) accordé aux requêtes en cours avant l'arrêt forcé sur SIGTERM.
SHUTDOWN_TIMEOUT_MS=10000

# ══════════════════════════════════════════════════════════════════════════════
# Variables additionnelles lues par le code (overrides — laisser vide = défaut)
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de données (options) ─────────────────────────────────────────────────
# SSL requis par la plupart des Postgres managés (Supabase/Neon). true en prod.
DB_SSL=true

# ── Journalisation ────────────────────────────────────────────────────────────
# Niveau pino : trace|debug|info|warn|error. Défaut : info (debug hors prod).
LOG_LEVEL=info

# ── Routes de dev/admin ───────────────────────────────────────────────────────
# En production, /api/dev n'est PAS monté sauf opt-in explicite ci-dessous.
# Laisser vide/false en prod normale (réduit la surface d'attaque).
ENABLE_DEV_ROUTES=false

# ── JWT / refresh tokens (TTL) ────────────────────────────────────────────────
# Durée de vie du refresh token. Défauts : 7j normal, 30j "remember me".
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_REMEMBER=30d
# Jours de grâce avant purge des refresh tokens révoqués/expirés (cleanup job).
TOKEN_CLEANUP_GRACE_DAYS=7

# ── Store de rate-limiting partagé (multi-instance) ───────────────────────────
# SANS Redis, express-rate-limit utilise un store mémoire PAR INSTANCE : les
# compteurs ne sont pas partagés entre instances Railway et sont remis à zéro à
# chaque redeploy (anti-brute-force + codes promo affaiblis en multi-instance).
# Renseigner l'URL Redis en prod multi-instance.
REDIS_URL=

# ── Ask LLM (garde-fous PRO / GitHub Models) ──────────────────────────────────
# Quota quotidien de requêtes LLM par utilisateur.
LLM_DAILY_QUOTA=50
# Timeout (ms) des appels au fournisseur LLM.
LLM_FETCH_TIMEOUT_MS=20000
# Bornes de taille des entrées (anti-abus / coût).
LLM_MAX_PROMPT_CHARS=4000
LLM_MAX_SYSTEM_CHARS=2000

# ── Codes promo Pro (activation sans paiement) ────────────────────────────────
# Paires CODE:JOURS séparées par des virgules. Ex : LAUNCH30:30,VIP:365
# Codes = secrets devinables → protégés par redeemLimiter (10 essais/h/user).
PRO_PROMO_CODES=

# ── Value bet scan (seuils de détection) ──────────────────────────────────────
# Edge min/max retenu et espérance de valeur minimale.
VALUE_BET_MIN_EDGE=0.03
VALUE_BET_MAX_EDGE=0.30
VALUE_BET_MIN_EV=0.0

# ── Log des cotes (audit / dataset) ───────────────────────────────────────────
# Active l'écriture d'un log CSV des cotes observées + chemin du fichier.
ODDS_LOG_ENABLED=false
ODDS_LOG_PATH=ml/data/odds_live_log.csv

# ── Chemins des données du soir (JSON datés manuels) ──────────────────────────
# Remplacent les chemins par défaut si les fichiers sont ailleurs.
SCRATCHES_PATH=ml/data/scratches.json
STARTING_GOALIES_PATH=ml/data/starting_goalies.json
