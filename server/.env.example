# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://iceedge.vercel.app   # URL Vercel en prod

# ── Base de données ───────────────────────────────────────────────────────────
# Option A : Supabase (copier depuis Settings → Database → URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Option B : variables séparées (Railway les injecte automatiquement)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=IceedgeDB
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ton-backend.railway.app/api/auth/google/callback
CLIENT_URL=https://iceedge.vercel.app

# ── Service ML Python ─────────────────────────────────────────────────────────
ML_SERVICE_URL=https://iceedge-ml.railway.app
