# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://iceedge.vercel.app   # URL Vercel en prod

# ── Base de données ───────────────────────────────────────────────────────────
# Option A : Neon — dashboard → Connection Details → cocher « Connection pooling ».
# L'hôte DOIT contenir "-pooler" : l'endpoint direct plafonne à quelques dizaines
# de connexions et sature dès qu'on scale (voir DEPLOYMENT.md §1). Le serveur
# émet un avertissement au démarrage si ce n'est pas le cas.
DATABASE_URL=postgresql://[USER]:[PASSWORD]@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/iceedge?sslmode=require

# Option B : variables séparées (Railway les injecte automatiquement)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=IceedgeDB
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Chiffrement au repos (secrets utilisateurs) ───────────────────────────────
# Clé 32 octets (64 caractères hex) pour chiffrer les secrets stockés en base
# (ex. la clé OpenAI personnelle des utilisateurs FREE). AES-256-GCM.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBLIGATOIRE en production. Après l'avoir définie : npm run db:encrypt-keys
ENCRYPTION_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ton-backend.railway.app/api/auth/google/callback
CLIENT_URL=https://iceedge.vercel.app

# ── OpenAI, clé de l'OPÉRATEUR (Ask LLM pour les abonnés PRO) ────────────────
# https://platform.openai.com/api-keys → commence par sk-...
# ⚠️ C'est TA clé et TA facture : elle sert les requêtes des abonnés Pro. Le
# nombre de requêtes est plafonné par abonné (voir PRO_PRICE_MONTHLY plus bas)
# et le modèle est imposé côté serveur, précisément pour que cette facture reste
# bornée. Les utilisateurs FREE utilisent leur propre clé (Paramètres → IA).
OPENAI_API_KEY=
# Modèle du chemin Pro. ⚠️ Le changer OBLIGE à mettre à jour
# LLM_PRICE_INPUT_PER_MTOK / LLM_PRICE_OUTPUT_PER_MTOK, sinon le plafond
# mensuel est calculé sur le tarif d'un autre modèle.
LLM_PRO_MODEL=gpt-5.6-luna
# Modèle par défaut du chemin FREE (clé de l'utilisateur). Il peut en demander
# un autre depuis le client ; sur le chemin Pro le modèle n'est PAS négociable.
LLM_FREE_MODEL=gpt-5.6-luna
# Effort de raisonnement (none | low | medium | high). `none` par défaut : la
# gamme gpt-5.6 raisonne à `medium` sans qu'on le demande, et ces tokens de
# réflexion invisibles sont facturés comme de la SORTIE. « Explique ce pari »
# part de données déjà calculées : il n'y a rien à raisonner, juste à rédiger.
# ⚠️ Le remonter oblige à remonter LLM_MAX_OUTPUT_TOKENS — la réflexion s'y impute.
LLM_REASONING_EFFORT=none

# GITHUB_MODELS_TOKEN : RETIRÉ. GitHub Models a fermé le 30 juillet 2026
# (playground, catalogue, API d'inférence). La variable ne sert plus à rien.

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Clé API depuis https://resend.com/api-keys. Laisser vide en dev → les codes
# sont affichés dans la console au lieu d'être envoyés.
RESEND_API_KEY=
# Expéditeur vérifié. En test, utiliser onboarding@resend.dev.
RESEND_FROM=ArakIce <onboarding@resend.dev>

# Adresse de support publiée (PRE_IOS_PLAN.md R4.0). Elle part dans les e-mails
# sortants. ⚠️ Le client a SA propre copie, VITE_SUPPORT_EMAIL dans Vercel —
# poser la même adresse des deux côtés. Absente → support.arakice@gmail.com,
# l'adresse en service. ⚠️ À ne pas confondre avec arakice.support@gmail.com,
# la boîte morte que ce projet a abandonnée.
SUPPORT_EMAIL=

# ── Web Push (notifications value bets) ───────────────────────────────────────
# Générer une fois : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@iceedge.app
PUSH_SCAN_ENABLED=false
PUSH_SCAN_INTERVAL_MIN=30
# Notifications envoyées EN PARALLÈLE sur tout un lot de destinataires (audit,
# ligne G). Sans plafond, un scan à 2 000 abonnés ouvrait ~3 000 sockets d'un
# coup et saturait le pool Postgres : l'API ne répondait plus pendant l'envoi.
PUSH_CONCURRENCY=20

# ── Règlement automatique des paris (settlement) ──────────────────────────────
# Le job de règlement est événementiel : il dort jusqu'à l'approche de l'heure
# de début du prochain match référencé par un slip en attente, poll vite pendant
# le match, puis se rendort. Quand rien n'est en attente, il dort longtemps pour
# laisser la base Neon se mettre en veille (scale-to-zero) et réduire le compute.
# Un nouveau pari réveille le job immédiatement (kick in-process).
#   SETTLEMENT_POLL_MIN     : intervalle rapide pendant qu'un match est en cours (défaut 2)
#   SETTLEMENT_IDLE_POLL_MIN: intervalle quand rien n'est en attente (défaut 15 en prod)
#   SETTLEMENT_PREROLL_MIN  : combien de minutes avant le coup d'envoi commencer à poller (défaut 2)
#   SETTLEMENT_FALLBACK_MIN : passe de sécurité complète, filet de secours (défaut 60)
# Pour revenir à un poll fixe toutes les 5 min : SETTLEMENT_POLL_MIN=5 et SETTLEMENT_IDLE_POLL_MIN=5.
SETTLEMENT_POLL_MIN=2
SETTLEMENT_IDLE_POLL_MIN=15
SETTLEMENT_PREROLL_MIN=2
SETTLEMENT_FALLBACK_MIN=60
# Débit d'une passe (audit, ligne H). La passe boucle désormais jusqu'à épuisement
# de la file ; c'est le BUDGET TEMPS qui l'arrête, plus un plafond fixe de 200
# tickets qui laissait des paris en attente pendant des jours après une grosse
# soirée. Chaque budget doit rester sous le TTL du bail du job (5 et 15 min).
#   SETTLEMENT_BATCH            : tickets lus par aller-retour Postgres (défaut 100)
#   SETTLEMENT_MAX_SLIPS        : garde-fou anti-boucle-infinie (défaut 5000)
#   SETTLEMENT_BUDGET_MS        : budget par défaut d'une passe (défaut 120000)
#   SETTLEMENT_LEG_CONCURRENCY  : jambes d'un ticket traitées en parallèle (défaut 4)
SETTLEMENT_BATCH=100
SETTLEMENT_MAX_SLIPS=5000
SETTLEMENT_BUDGET_MS=120000
SETTLEMENT_LEG_CONCURRENCY=4

# ── Mode veille hors-saison ───────────────────────────────────────────────────
# true = l'API démarre normalement mais AUCUN job de fond ne tourne (règlement,
# value bets, nettoyage, log des cotes). Sert à laisser le compute Neon dormir
# hors saison NHL. Conséquence : les paris placés pendant cette période restent
# en attente jusqu'au retour à false (le job rattrape tout au redémarrage).
# Attention : ce n'est pas zéro compute — une visite du site réveille la base.
DORMANT=false

# ── Sonde de readiness (/health/ready) ────────────────────────────────────────
# Durée de mise en cache d'un SELECT 1 réussi. Neon suspend son compute après
# 5 min d'inactivité : une sonde de monitoring toutes les 1-5 min qui interroge
# la base à chaque appel maintient le compute allumé 24/7 et annule le travail
# événementiel du job de règlement ci-dessus. Le TTL doit donc rester supérieur
# à la fenêtre de suspension. Les échecs ne sont jamais mis en cache : panne et
# rétablissement sont vus à la cadence réelle des sondes.
READINESS_DB_TTL_MS=600000

# DEV UNIQUEMENT : true = désactive la confirmation par courriel (inscription
# connecte directement, login jamais bloqué). Remettre à false une fois Resend prêt.
EMAIL_VERIFICATION_DISABLED=false

# ── Abonnements (Stripe) ──────────────────────────────────────────────────────
# Laisser STRIPE_SECRET_KEY vide → /subscription/checkout active Pro en mode démo
# (sans paiement) pour tester le gating. Une fois branché, remplir ces valeurs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ⚠️ ID de TARIF (`price_…`), pas ID de produit (`prod_…`). Les deux se copient
# au même endroit du tableau de bord Stripe ; un `prod_…` ici fait échouer le
# paiement avec « No such price ». Le serveur refuse désormais explicitement.
STRIPE_PRICE_PRO_MONTHLY=
# Laisser vide = pas de cadence annuelle sur /pro (le sélecteur disparaît).
STRIPE_PRICE_PRO_YEARLY=
# Rétention du registre de déduplication des webhooks (`stripe_events`, purgé par
# le job de nettoyage). Doit couvrir la fenêtre de redélivrance de Stripe.
STRIPE_EVENT_RETENTION_DAYS=30
# Durée de mise en cache de l'entitlement Pro (audit, ligne L). `isPro` était une
# requête Postgres à chaque appel LLM et à chaque route Pro. Toute écriture sur
# l'abonnement invalide l'entrée, donc un paiement prend effet immédiatement ;
# ce TTL ne borne que la propagation d'un downgrade entre instances.
PRO_CACHE_TTL_MS=60000

# ── Service ML Python ─────────────────────────────────────────────────────────
# EN PROD : pas de domaine public sur le service ML. Utiliser le réseau privé
# Railway → http://<nom-du-service>.railway.internal:<port> (gratuit, pas d'egress,
# surface d'attaque nulle). Le port est celui qu'uvicorn annonce au démarrage
# ("Uvicorn running on http://[::]:8080") — Railway injecte $PORT, souvent 8080,
# et non le 8000 par défaut du Dockerfile. Cf. DEPLOYMENT.md §3.
ML_SERVICE_URL=http://iceedge-ml.railway.internal:8080
# Mettre à true pour lancer SANS le service ML (l'app retombe sur les règles).
# Évite les appels inutiles au service Python quand il n'est pas déployé.
ML_DISABLED=false
# Secret partagé envoyé dans l'en-tête X-ML-Token à chaque appel d'inférence.
# DOIT être identique à ML_API_TOKEN côté service Python, qui refuse de démarrer
# sans lui en prod. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ML_API_TOKEN=
# Disjoncteur + cache d'inférence (audit, ligne M). Après N échecs consécutifs
# décrivant le SERVICE (réseau, timeout, 5xx, 401/403/429), les appels échouent
# immédiatement pendant la fenêtre de repos et l'app retombe sur les règles sans
# attendre le timeout de 5 s — sinon chaque requête entrante paie 5 s d'attente
# pour un service dont on sait déjà qu'il ne répond pas.
ML_BREAKER_THRESHOLD=5
ML_BREAKER_COOLDOWN_MS=60000
# Le modèle est déterministe : mêmes features, même sortie. TTL court quand même,
# car les features (blessures, gardien annoncé, cotes) changent, elles.
ML_CACHE_TTL_MS=300000

# ── The Odds API (cotes de livres, proxifié par /api/odds) ────────────────────
# Plan 20K (20 000 crédits/mois, remis à zéro le 1er) depuis le 2026-09-27.
# Vit UNIQUEMENT côté serveur — le client passe par le proxy /api/odds/*, la clé
# n'est jamais envoyée au navigateur. La MÊME clé sert au backfill
# (ml/python/fetch_data_v4.py) : les deux puisent dans le même quota.
ODDS_API_KEY=
# ⚠️ The Odds API ne cote NI Bet365 NI Stake sur la NHL. Deux livres distincts :
#   ODDS_BOOKMAKERS         affiché dans l'app (livre canadien, sous son vrai nom)
#   ODDS_COLLECT_BOOKMAKERS série de cotes du ML (collecte live + CLV) — DOIT
#                           être le même que `--odds-api-book` du backfill.
# Choix fait au sondage du 2026-09-27 (ml/python/probe_odds_books.py).
ODDS_BOOKMAKERS=betano_ca_on
ODDS_COLLECT_BOOKMAKERS=draftkings
# Durée du cache d'affichage, en minutes. LE levier du budget : 30 min ≈ 4 500
# crédits/mois au pire (trafic continu), 5 min ≈ 26 000 — plus que le plan.
ODDS_CACHE_TTL_MIN=30
# Marchés de match supplémentaires (résultat en 60 min, périodes, totaux alt.),
# match par match — 1 crédit par marché RENVOYÉ. Plafond quotidien : 80 tant
# que le backfill tourne, ~300 ensuite. La liste par défaut est dans oddsClient.ts.
ODDS_EXTRAS_DAILY_BUDGET=80
ODDS_EXTRAS_TTL_MIN=120

# ── Stockage des avatars (Cloudflare R2) ──────────────────────────────────────
# Sans ces variables, les avatars restent stockés en data-URI base64 dans
# Postgres (comportement historique) — l'app fonctionne, mais chaque avatar pèse
# ~27 ko dans la base ET dans chaque payload de chat/leaderboard.
#
# Mise en place, une fois, dans le dashboard Cloudflare :
#   1. R2 → Create bucket (« arakice-avatars »).
#   2. Onglet Settings du bucket → Public access : activer le sous-domaine r2.dev
#      OU brancher un domaine perso (ex. cdn.arakice.com). Copier l'URL obtenue
#      dans R2_PUBLIC_URL — c'est elle que les navigateurs appelleront.
#   3. R2 → Manage API tokens → Create token, permission « Object Read & Write »,
#      limité à ce seul bucket. Copier Access Key ID et Secret Access Key.
#   4. R2_ACCOUNT_ID = l'Account ID visible en haut à droite du dashboard.
#
# Le bucket doit être public en LECTURE seule (les écritures passent par le
# serveur, avec le token ci-dessous). Ne jamais exposer ces clés au client.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# DOIT correspondre exactement au nom du bucket dans le dashboard R2.
R2_BUCKET=arakice-avatars
# Sans slash final. Ex. https://pub-xxxxxxxx.r2.dev ou https://cdn.arakice.com
R2_PUBLIC_URL=

# Optionnel. À renseigner UNIQUEMENT si le bucket a été créé avec une
# « jurisdiction » (EU / FedRAMP) : il n'est alors pas joignable sur l'endpoint
# standard et R2 répond « Access Denied ».
#   Jurisdiction EU → https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Données NHL ───────────────────────────────────────────────────────────────
# Mettre à true pour peupler artificiellement matchs/équipes/joueurs avec des
# données mock (utile hors-saison ou en démo). false = API NHL live.
NHL_USE_MOCK=false
# Délai au bout duquel un appel à l'API NHL est abandonné.
# Trouvé par le tir de charge S1 (2026-08-03) : le module n'avait AUCUN timeout,
# donc `fetch` s'en remettait au défaut d'undici — 300 s, effectivement observé.
# Comme les requêtes concurrentes sur la même URL sont dédoublonnées, un seul
# appel bloqué retient TOUS ses appelants : le rayon de souffle est l'application
# entière. Tous les appelants ont un repli, donc un dépassement se voit comme
# « une section sans donnée », pas comme une page figée.
NHL_TIMEOUT_MS=8000
# Repli sur la dernière réponse connue quand l'API NHL est KO (audit, ligne Y).
# Sans lui, une panne d'amont se voit comme un 500 côté utilisateur — c'est ce
# qui s'est produit pendant le tir S1. Passé ce délai l'entrée est oubliée :
# mieux vaut une erreur franche qu'un calendrier de la veille présenté comme
# courant. Le plafond d'entrées borne la mémoire (les clés sont des URL).
STALE_FALLBACK_TTL_MS=1800000
STALE_FALLBACK_MAX_ENTRIES=120

# ── Monitoring d'erreurs (Sentry) ─────────────────────────────────────────────
# DSN du projet Sentry backend. Vide → monitoring désactivé (no-op).
SENTRY_DSN=
# Fraction des requêtes tracées pour la PERFORMANCE (0.0–1.0). Les erreurs, elles,
# partent toujours à 100 % — c'est la confusion classique, et elle pousse à garder
# un taux trop haut « pour ne rien rater ».
# LAISSER VIDE en production : le code prend alors 0.01 (et 0.1 hors production),
# ce qui est le comportement voulu. À 0.1 et ~200 req/s on émettrait ~52 M de
# transactions/mois, très au-delà des quotas inclus, et le dépassement ne se voit
# que sur la facture. Ne renseigner que pour s'en écarter volontairement, par
# exemple 1.0 le temps d'une investigation.
SENTRY_TRACES_SAMPLE_RATE=

# ── Arrêt gracieux ────────────────────────────────────────────────────────────
# Délai (ms) accordé aux requêtes en cours avant l'arrêt forcé sur SIGTERM.
SHUTDOWN_TIMEOUT_MS=10000

# ══════════════════════════════════════════════════════════════════════════════
# Variables additionnelles lues par le code (overrides — laisser vide = défaut)
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de données (options) ─────────────────────────────────────────────────
# SSL requis par la plupart des Postgres managés (Supabase/Neon). true en prod.
DB_SSL=true

# ── Journalisation ────────────────────────────────────────────────────────────
# Niveau pino : trace|debug|info|warn|error. Défaut : info (debug hors prod).
LOG_LEVEL=info

# ── Routes de dev/admin ───────────────────────────────────────────────────────
# En production, /api/dev n'est PAS monté sauf opt-in explicite ci-dessous.
# Laisser vide/false en prod normale (réduit la surface d'attaque).
ENABLE_DEV_ROUTES=false

# ── JWT / refresh tokens (TTL) ────────────────────────────────────────────────
# Durée de vie du refresh token. Défauts : 7j normal, 30j "remember me".
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_REMEMBER=30d
# Jours de grâce avant purge des refresh tokens révoqués/expirés (cleanup job).
TOKEN_CLEANUP_GRACE_DAYS=7

# ── Store de rate-limiting partagé (multi-instance) ───────────────────────────
# SANS Redis, express-rate-limit utilise un store mémoire PAR INSTANCE : les
# compteurs ne sont pas partagés entre instances Railway et sont remis à zéro à
# chaque redeploy (anti-brute-force + codes promo affaiblis en multi-instance).
# Renseigner l'URL Redis en prod multi-instance.
# ── REDIS — requis SEULEMENT à partir de la 2ᵉ instance ─────────────────────
#
# Absent : l'application fonctionne normalement, mais la diffusion Socket.io est
# LOCALE au conteneur. Correct à une instance, silencieusement faux à deux —
# deux personnes du même salon ne se voient que si le répartiteur les a posées
# sur le même conteneur (audit ligne D, banc `loadtest/bench/b12-multiinstance`).
#
# Présent : `@socket.io/redis-adapter` relaie les diffusions entre instances.
#
# Railway : ajouter le plugin Redis dans le MÊME projet, la variable est fournie
# sur le réseau privé. Upstash : prendre l'URL `rediss://…` (endpoint Redis),
# PAS l'URL REST — le pub/sub exige une connexion persistante.
#
# Le client doit rester en `transports: ['websocket']` : Railway ne fait pas
# d'affinité de session, et le long-polling en aurait besoin.
REDIS_URL=

# ── Ask LLM (garde-fous PRO / GitHub Models) ──────────────────────────────────
# Quota quotidien par utilisateur FREE uniquement (ils paient leurs propres
# tokens via leur clé OpenAI : ce compteur protège nos ressources serveur, pas
# un budget). Le budget des PRO est plafonné mensuellement, voir plus bas.
LLM_DAILY_QUOTA=50
# Timeout (ms) des appels au fournisseur LLM.
LLM_FETCH_TIMEOUT_MS=20000
# Bornes de taille des entrées (anti-abus / coût). Elles entrent DIRECTEMENT
# dans le calcul du plafond mensuel : les augmenter renchérit le coût pire-cas
# d'une requête, donc réduit automatiquement le nombre de requêtes autorisées.
LLM_MAX_PROMPT_CHARS=4000
LLM_MAX_SYSTEM_CHARS=2000
# Budget de sortie envoyé au fournisseur (max_tokens).
LLM_MAX_OUTPUT_TOKENS=512

# ── Plafond de coût IA des abonnés Pro ────────────────────────────────────────
#
# GARANTIE : « ne jamais payer plus que ce que l'utilisateur paie. »
# Elle n'est pas surveillée, elle est CALCULÉE :
#
#     plafond mensuel = (PRO_PRICE_MONTHLY × LLM_BUDGET_SHARE)
#                       ÷ coût pire-cas d'une requête
#
# Le coût pire-cas est dérivé des bornes de taille ci-dessus et des tarifs du
# modèle, ×2 pour la réessai automatique sur panne. Le plafond effectif est
# journalisé au démarrage — vérifie-le après chaque changement de tarif.
#
# Le résultat est ensuite BORNÉ par LLM_PROMISED_QUOTA (500), le chiffre rond
# annoncé aux abonnés. Le calcul décide donc du maximum, la promesse de ce qu'on
# affiche : min(calcul, promesse). Ne recopie aucun chiffre d'ici — le plafond
# effectif est journalisé au démarrage, c'est lui qui fait foi.
#
# Avec les défauts du code (prompt 8000 + système 2000 + 512 en sortie,
# gpt-5.6-luna) : 1,80 $ de budget ÷ 0,00237 $/requête ≈ 757 possibles,
# ramenés à 500 par la promesse.
#
# Prix mensuel de l'abonnement Pro (doit correspondre au prix Stripe réel).
# ⚠️ La cadence ANNUELLE paie moins par mois : 60 $/an = 5,00 $/mois, ~4,80 $ net
# de commission Stripe. Dimensionner sur 5,99 surestime donc de ~20 % ce que paie
# un abonné annuel — la garantie tient quand même (1,80 $ de plafond IA face à
# 4,80 $ encaissés), mais pour dimensionner sur le moins-disant, poser 5.
PRO_PRICE_MONTHLY=5.99
# Part de l'abonnement allouée à l'IA (0–1). Le reste couvre l'hébergement,
# la commission Stripe (~2,9 % + 0,30 $) et la marge.
LLM_BUDGET_SHARE=0.30
# Tarifs du modèle Pro, par million de tokens. Défauts = gpt-5.6-luna
# (0,20 / 1,20 au 2026-09). ⚠️⚠️ Ces deux lignes et LLM_PRO_MODEL décrivent le
# MÊME modèle : changer l'un sans l'autre ne casse rien visiblement, le plafond
# est simplement calculé sur le tarif d'un autre modèle.
LLM_PRICE_INPUT_PER_MTOK=0.20
LLM_PRICE_OUTPUT_PER_MTOK=1.20
# Le chiffre ROND promis aux abonnés (« 500 analyses par mois »), affiché sur
# /pro et dans le compteur des Réglages. Il BORNE le calcul, il ne le remplace
# pas : si le calcul retombe en dessous, c'est lui qui gagne et le chiffre
# annoncé baisse partout en même temps. Le démarrage le signale en warn.
LLM_PROMISED_QUOTA=500
# Surcharge EXPLICITE, pour une opération commerciale : elle court-circuite le
# min(calcul, promesse) et peut donc dépasser le plafond calculé, ce qui rompt
# la garantie — le démarrage le signale en warn. Laisser vide en temps normal.
LLM_MONTHLY_QUOTA=
# Disjoncteur global mensuel, toutes personnes confondues. Le plafond par
# utilisateur borne déjà la dépense totale ; celui-ci couvre l'erreur de
# paramétrage (prix mal saisi, tarif fournisseur changé, modèle plus cher
# branché par mégarde). 10 000 ≈ 24 $ aux tarifs ci-dessus.
LLM_GLOBAL_MONTHLY_CAP=10000

# Bet builder IA (tâche parse_bet_command, 2026-09-28) : appels offerts PAR
# JOUR à un compte GRATUIT sans clé perso, sur la clé de l'OPÉRATEUR. Compteur
# en base (migration 039). Avec sa propre clé, un compte gratuit passe par elle.
# ⚠️ Le chiffre n'est jamais recopié dans une traduction : l'API le renvoie.
LLM_FREE_PARSE_DAILY=2
# Disjoncteur MENSUEL de ces appels gratuits, toutes personnes confondues.
# SÉPARÉ de LLM_GLOBAL_MONTHLY_CAP (Pro) depuis le 2026-09-29 : le gratuit ne
# peut plus couper l'IA aux abonnés. 5 000 ≈ 11,85 $/mois au pire cas actuel.
LLM_FREE_GLOBAL_MONTHLY_CAP=5000
# Rétention des compteurs journaliers ci-dessus (cleanup.service.ts), en jours.
LLM_FREE_DAILY_RETENTION_DAYS=7

# ── Codes promo Pro (activation sans paiement) ────────────────────────────────
# Paires CODE:JOURS séparées par des virgules. Ex : LAUNCH30:30,VIP:365
# Codes = secrets devinables → protégés par redeemLimiter (10 essais/h/user).
PRO_PROMO_CODES=

# ── Value bet scan (seuils de détection) ──────────────────────────────────────
# Edge min/max retenu et espérance de valeur minimale.
VALUE_BET_MIN_EDGE=0.03
VALUE_BET_MAX_EDGE=0.30
VALUE_BET_MIN_EV=0.0

# ── Log des cotes (audit / dataset) ───────────────────────────────────────────
# Capture les cotes NHL observées dans la table `odds_log` (migrations 027/028).
# Le disque Railway est éphémère : l'ancien log CSV disparaissait à chaque
# déploiement. Export vers le format de fetch_data_v4.py : `npm run odds:export`.
#
# À LAISSER À true. Depuis 2026-08-04 c'est la SEULE source possible pour les
# prix over/under et la puck line : l'archive sportsbookreviewsonline s'arrête
# à 2022-23 et ne sera plus mise à jour, et l'endpoint historique de The Odds
# API n'est pas servi aux clés gratuites. La collecte ne rattrape pas le passé —
# chaque jour où ce drapeau est à false est perdu définitivement.
ODDS_LOG_ENABLED=true

# Calendrier de collecte (A3, 2026-08-23) — il n'y a rien à régler ici, mais il
# faut savoir ce qu'il dépense. Six passes par jour calées sur l'heure de l'Est :
# deux complètes (11 h et 17 h, 3 crédits chacune) et quatre `spreads` seules
# (18 h 45 / 19 h 45 / 21 h 45 / 22 h 45, 1 crédit chacune) = 10 crédits/jour,
# soit 300 par mois de saison. Le calendrier vit dans `SLOTS`
# (`oddsLogger.service.ts`) ; le changer change la facture.
#
# Chaque passe archive en plus son état complet dans `odds_snapshots`
# (migration 031) — c'est la série temporelle dont le CLV a besoin, et elle ne
# coûte aucun crédit de plus : l'appel ramenait déjà ces prix.

# Lance UNE passe complète 20 s après le démarrage, pour vérifier la chaîne de
# bout en bout sans attendre le prochain créneau. Coûte 3 crédits à CHAQUE
# démarrage, et Railway redéploie souvent : à poser le temps d'un déploiement,
# puis à retirer.
#
# ⚠️ INUTILE HORS SAISON, et pas seulement inefficace : `logTodaysOdds` sort sur
# le garde-fou `isSeasonActive()` AVANT toute écriture (juin → début octobre).
# La passe ne coûte alors rien — mais elle n'écrit rien non plus, et le log dit
# « NHL inactive », pas « chaîne vérifiée ». Ce drapeau ne prouve quoi que ce
# soit qu'à partir de la pré-saison. En attendant, c'est le contrôle de
# `odds_snapshots` au démarrage (`startOddsLogger`) qui atteste que la 031 est
# appliquée, et `GET /api/dev/data-health` qui montre la table se remplir.
ODDS_LOG_RUN_AT_BOOT=false

# ── Arbitrage du quota The Odds API ───────────────────────────────────────────
# Une seule clé, deux consommateurs : le proxy public (visiteurs) et le
# collecteur de fond. Sur une clé gratuite (500 crédits/mois) le proxy peut à
# lui seul vider le quota en une journée.
#
# Règle : le collecteur s'arrête dès qu'il resterait moins que cette réserve,
# le proxy peut descendre jusqu'à zéro. Une journée de collecte perdue est
# regrettable ; un visiteur devant une page vide l'est davantage.
ODDS_USER_RESERVE=150

# Seuil d'alerte dans les logs sur les crédits restants.
ODDS_QUOTA_WARN=100

# ── Chemins des données du soir (JSON datés manuels) ──────────────────────────
# Remplacent les chemins par défaut si les fichiers sont ailleurs.
SCRATCHES_PATH=ml/data/scratches.json
STARTING_GOALIES_PATH=ml/data/starting_goalies.json

# ── Coupons publics (page joueur, réservée aux abonnés Pro) ───────────────────
# Date à partir de laquelle un coupon peut être montré à un AUTRE joueur.
# Tout coupon déposé avant reste privé pour toujours : il a été saisi quand le
# produit promettait l'inverse, et rendre cela public rétroactivement n'est pas
# défendable. Le propriétaire, lui, voit toujours l'intégralité de son historique.
#
# ÉCHEC FERMÉ : si cette variable est absente ou illisible, AUCUN coupon n'est
# visible aux tiers (avec un warn au démarrage). Une variable oubliée doit
# casser le feature, jamais la vie privée.
#
# À renseigner le jour de la bascule — viser le début de saison NHL, sinon la
# page démarre sur trois semaines de vide. Format ISO 8601.
# PUBLIC_SLIPS_SINCE=2026-10-07T00:00:00Z
