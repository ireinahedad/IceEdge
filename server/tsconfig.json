{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // @x402/* ne publient leurs types que via `exports`, que la résolution
    // `node10` (défaut de module commonjs) ignore. À l'exécution, Node lit
    // `exports` et charge le build cjs : ces chemins pointent sur ses types.
    "paths": {
      "@x402/express": ["./node_modules/@x402/express/dist/cjs/index.d.ts"],
      "@x402/core/server": ["./node_modules/@x402/core/dist/cjs/server/index.d.ts"],
      "@x402/evm/exact/server": ["./node_modules/@x402/evm/dist/cjs/exact/server/index.d.ts"],
      "@x402/extensions/bazaar": ["./node_modules/@x402/extensions/dist/cjs/bazaar/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/app.controller.ts",
    "src/app.controller.spec.ts",
    "src/app.module.ts",
    "src/app.service.ts",
    "src/main.ts"
  ]
}
