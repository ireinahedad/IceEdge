{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User authentication & management service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "seed": "ts-node src/db/seed.ts",
    "db:migrate": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "db:migrate:all": "ts-node src/db/migrate-all.ts",
    "db:migrate:slips": "ts-node src/db/migrate-slips.ts",
    "db:encrypt-keys": "ts-node src/db/encrypt-openai-keys.ts",
    "odds:export": "ts-node scripts/export-odds-log.ts",
    "odds:export-snapshots": "ts-node scripts/export-odds-snapshots.ts",
    "notify:slips": "ts-node scripts/notify-slips-visibility.ts",
    "content:insights": "ts-node scripts/build-content-insights.ts",
    "content:mine": "ts-node scripts/mine-stories.ts",
    "content:recap": "ts-node scripts/build-recap.ts",
    "content:check": "ts-node scripts/check-posts.ts",
    "content:log": "ts-node scripts/log-post.ts",
    "moderation:dry-run": "ts-node scripts/moderation-dry-run.ts",
    "content:render": "ts-node scripts/render-slides.ts",
    "content:video": "ts-node scripts/build-video.ts",
    "settle:stuck": "ts-node scripts/settle-stuck-slips.ts",
    "purge:stale": "ts-node scripts/purge-stale-slips.ts",
    "injuries:sync": "ts-node scripts/sync-injuries.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@sentry/node": "^10.75.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.3",
    "stripe": "^17.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.62.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
