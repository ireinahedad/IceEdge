    },
    {
      "source": "/props/:slug((?!(?:adin-hill|aleksander-barkov|auston-matthews|beckett-sennecke|ben-meyers|berkly-catton|cale-makar|carl-lindbom|collin-graf|colton-parayko|connor-dewar|cutter-gauthier|danila-yurov|dylan-strome|elias-pettersson-8483678|filip-chytil|filip-forsberg|filip-hronek|frank-nazar|gabe-perreault|garnet-hathaway|ilya-protas|ivan-miroshnichenko|jack-drury|jack-mcbain|jack-quinn|jackson-lacombe|jake-neighbours|jared-mccann|jason-robertson|jesper-wallstedt|jiri-kulich|joel-kiviranta|john-tavares|juraj-slafkovsky|justus-annunen|kent-johnson|konsta-helenius|kyle-capobianco|logan-cooley|lucas-raymond|lukas-dostal|mackie-samoskevich|macklin-celebrini|maksymilian-szuber|martin-necas|mason-mctavish|matthew-schaefer|matthew-tkachuk|matthew-wood|mattias-samuelsson|matty-beniers|matvei-michkov|mavrik-bourque|mikko-rantanen|morgan-frost|moritz-seider|nick-paul|noah-dobson|patrick-kane|porter-martone|sam-dickinson|sam-rinzel|thomas-harley|trevor-van-riemsdyk|trevor-zegras|vince-dunn|will-borgen|will-smith|yaroslav-askarov|yegor-sharangovich)$)[^/]+)",
      "destination": "/nhl-player-props",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*/",
      "destination": "https://us.i.posthog.com/:path*/"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    {
      "source": "/((?!assets/|ingest/|\\.well-known/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ocr/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src https://accounts.google.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
