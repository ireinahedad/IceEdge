# ── Client (Vite) env — safe to expose (all VITE_* vars ship to the browser) ──
# Do NOT put secrets here. Server-only secrets (Odds API key, etc.) live in
# server/.env and are proxied through the API.
#
# All of these are read in exactly one place: src/app/env.ts. Nothing else in
# the client may touch import.meta.env directly (PRE_IOS_PLAN.md R7).
# `npm run check:env` validates this file's real counterparts before a build.

# ── Required. No fallback: a missing one is a configuration error, not a ──────
# ── silent redirect to localhost. Must be https:// in production. ────────────

# NHL data proxy. Its `/api/nhl` suffix is stripped to reach /api/llm and
# /api/predict, so keep the suffix.
VITE_NHL_API_URL=http://localhost:3001/api/nhl

# Profile + auth API. Its `/api` suffix is stripped for the Google OAuth entry
# point (/api/auth/google), so keep the suffix.
VITE_PROFILE_API_URL=http://localhost:3001/api

# Prediction / ML API. May point at a different host than the profile API.
VITE_PREDICTION_API_URL=http://localhost:3001/api

# Socket.io origin for the live chat. Origin only — no path.
VITE_SOCKET_URL=http://localhost:3001

# ── Optional. Absent is a supported configuration. ───────────────────────────

# Bet365 affiliate code (public link parameter). Links work untracked without it.
VITE_BET365_AFFILIATE_CODE=365_XXXXXXX

# Stake affiliate code (public link parameter). Links work untracked without it.
VITE_STAKE_AFFILIATE_CODE=XXXXXXX

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# Frontend DSN from your Sentry project. Empty → monitoring disabled (no-op).
# Deliberately optional: a missing analytics DSN must never become an outage.
# NB: a browser DSN is public by design; scope it to a frontend project.
VITE_SENTRY_DSN=
